{
  "name": "twilight-sword-champion-sheet",
  "private": true,
  "type": "module",
  "scripts": {
    "prettier:check": "prettier --check .",
    "prettier:write": "prettier --check --write .",
    "start": "npx --yes http-server@14.1.1 -c-1 -p 5500 -a 127.0.0.1",
    "test": "npm run prettier:check && npm run typecheck && npm run typecheck:e2e && npm run typecheck:tests && npm run test:unit",
    "test:unit": "vitest run",
    "typecheck": "tsc -p jsconfig.json",
    "typecheck:e2e": "tsc -p e2e/tsconfig.json",
    "typecheck:tests": "tsc -p tests/tsconfig.json"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/node": "22.20.5",
    "jsdom": "29.1.1",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": "22.22.0"
  }
}
