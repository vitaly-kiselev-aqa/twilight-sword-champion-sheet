{
  "compilerOptions": {
    "allowJs": true,
    "allowImportingTsExtensions": true,
    "strict": true,
    "noEmit": true,
    "target": "ES2022",
    "module": "nodenext",
    "moduleDetection": "legacy",
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "maxNodeModuleJsDepth": 0,
    "skipLibCheck": true
  },
  "include": ["**/*.ts", "../assets/js/**/*.js"]
}
